# Orbis Environment Variables
# Copy this to .env (development) or .env.production (server)
# DO NOT commit .env or .env.production to git!

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database
# For development (relative path):
DATABASE_URL=sqlite:///instance/orbis.db
# For production/Docker (absolute path):
# DATABASE_URL=sqlite:////app/instance/orbis.db

# Google OAuth Configuration (from Google Cloud Console - glass-world-209910 project)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# For development:
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/callback

# For production (orbis.zumgugger.ch):
# GOOGLE_REDIRECT_URI=https://orbis.zumgugger.ch/auth/callback

# Timezone
DEFAULT_TIMEZONE=Europe/Zurich

# Environment (development, production, test)
ORBIS_CONFIG=development

# Development mode (enables dev login, set to False in production!)
DEVELOPMENT_MODE=True
