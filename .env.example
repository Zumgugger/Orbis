# Orbis Environment Variables
# Copy this to .env (development) or .env.production (server)
# DO NOT commit .env or .env.production to git!

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database
# For development (relative path):
DATABASE_URL=sqlite:///instance/orbis.db
# For production/Docker (absolute path):
# DATABASE_URL=sqlite:////app/instance/orbis.db

# Google OAuth Configuration (from Google Cloud Console - glass-world-209910 project)
# ⚠️  IMPORTANT: Copy these from production .env.production, NOT from git!
# To get credentials: ssh root@1078 "cat /var/www/orbis/.env.production | grep GOOGLE"
GOOGLE_CLIENT_ID=1053107847673-9vner5tnjrihnrckd1fb3sdbebqtls0m.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-production

# ⚠️  DO NOT UNCOMMENT - Let the app auto-detect redirect URI for localhost
# (it will dynamically use http://localhost:5001/auth/callback or http://127.0.0.1:5001/auth/callback)
# Only set GOOGLE_REDIRECT_URI if you need a custom value
# GOOGLE_REDIRECT_URI=http://localhost:5001/auth/callback

# Timezone
DEFAULT_TIMEZONE=Europe/Zurich

# Environment (development, production, test)
ORBIS_CONFIG=development

# Development mode (enables dev login, set to False in production!)
DEVELOPMENT_MODE=True
